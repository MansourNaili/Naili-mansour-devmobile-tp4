<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran unique du Currency Converter.
    - Racine : ConstraintLayout (fond clair)
    - Zone du haut (45 % de la hauteur) : fond turquoise #2BB8E8
    - Zone du bas : clavier numérique = TableLayout de 4 lignes x 3 colonnes
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clavier">

    <!-- Ligne invisible placée à 45 % de la hauteur : sépare la zone du haut du clavier -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHaut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.45" />

    <!-- ============ ZONE DU HAUT ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zoneHaut"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/fond_zone_haut"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/guidelineHaut"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Titre -->
        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titre_ecran"
            android:textColor="@color/texte_blanc"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tvMontant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread" />

        <!-- Devise source (ex. USD) -->
        <Spinner
            android:id="@+id/spDeviseSource"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            app:layout_constraintBottom_toBottomOf="@id/tvMontant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvMontant" />

        <!-- Montant saisi : TextView (la saisie se fait par le clavier de l'appli) -->
        <TextView
            android:id="@+id/tvMontant"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:text="@string/montant_initial"
            android:textColor="@color/texte_blanc"
            android:textSize="48sp"
            app:autoSizeMaxTextSize="48sp"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/btnInverser"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spDeviseSource"
            app:layout_constraintTop_toBottomOf="@id/tvTitre" />

        <!-- Bouton inverser -->
        <ImageButton
            android:id="@+id/btnInverser"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/description_inverser"
            android:src="@drawable/ic_swap_vert"
            app:layout_constraintBottom_toTopOf="@id/tvResultat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvMontant" />

        <!-- Devise cible (ex. EUR) -->
        <Spinner
            android:id="@+id/spDeviseCible"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            app:layout_constraintBottom_toBottomOf="@id/tvResultat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvResultat" />

        <!-- Résultat de la conversion -->
        <TextView
            android:id="@+id/tvResultat"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:textColor="@color/texte_blanc"
            android:textSize="48sp"
            app:autoSizeMaxTextSize="48sp"
            app:autoSizeMinTextSize="24sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toTopOf="@id/btnConvertir"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/spDeviseCible"
            app:layout_constraintTop_toBottomOf="@id/btnInverser" />

        <!-- Bouton Convertir -->
        <Button
            android:id="@+id/btnConvertir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:backgroundTint="@color/fond_bouton_convertir"
            android:text="@string/bouton_convertir"
            android:textColor="@color/texte_bouton_convertir"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvResultat" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============ ZONE DU BAS : CLAVIER NUMÉRIQUE (TableLayout 4 x 3) ============ -->
    <TableLayout
        android:id="@+id/tableClavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineHaut">

        <!-- Ligne 1 : 7 8 9 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn7"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_7"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn8"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_8"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn9"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_9"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 2 : 4 5 6 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn4"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_4"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn5"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_5"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn6"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_6"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 3 : 1 2 3 -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btn1"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_1"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn2"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_2"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn3"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_3"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />
        </TableRow>

        <!-- Ligne 4 : C (rouge) 0 . -->
        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnEffacer"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_effacer"
                android:textColor="@color/touche_effacer"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btn0"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_0"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnPoint"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_point"
                android:textColor="@color/chiffre_clavier"
                android:textSize="32sp" />
        </TableRow>
    </TableLayout>
</androidx.constraintlayout.widget.ConstraintLayout>